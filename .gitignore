# Local-only material (payload, reference legend, tools, blobs binaries)
artifacts/
reference-3.14/
tools/
# Бинарии блобов НЕ в git; пиннинг sha256 для CI — в BLOBS-SHA256.txt (L101 Шаг 1.3)
blobs/*
!blobs/BLOBS-SHA256.txt
!blobs/README.md
payload_3.22.0*
*.apk
*.zip
*.jar
# вендорные jar, нужные для Gradle-сборки (wrapper + android.car)
!gradle/wrapper/gradle-wrapper.jar
!Native/app/lib/android.car.jar

# Decompile outputs: sources tracked, resources/smali/logs are reproducible
src-reconstructed/**/resources/
src-reconstructed/**/unknown/
src-reconstructed2/
res-reconstructed/
logs/

# Private until release (SPEC L94)
legal/

# Build / OS
build/
.gradle/
target/
node_modules/
__pycache__/
*.pyc
.idea/
.vscode/
*.log

# Локальный вывод сборки релиза (make_release.sh); исключение — каталог релизов,
# коммитится в Git (Docs/installer-protocol.md, CATALOG_URL installer-core)
Releases/*
!Releases/ota/
Releases/ota/*
!Releases/ota/index.json

# Строительный мусор: случайный CARGO_TARGET_DIR с windows-путём внутри Installer
# и дампы отладчиков
cargo-target/
*.stackdump
# Сборка web-интерфейса desktop (vite; CI собирает через npm run build)
Installer/desktop/dist/
# Сборка GUI-инсталлера (build.mjs): содержимое bundle пересоздаётся целиком
# (payload 125 МБ); .gitkeep остаётся — каталог резолвит tauri.conf.json
# (bundle.resources) для cargo check/build. Release-конфиг генерируется под платформу.
Installer/desktop/src-tauri/resources/bundle/*
!Installer/desktop/src-tauri/resources/bundle/.gitkeep
Installer/desktop/src-tauri/tauri.release.conf.json

# Приватность владельца (мастер-док телеметрии и его артефакты — ВНЕ репо, R5)
Qwen_*.md
art/

# Резервный комплект владельца (Приложение E) — хранится локально, не в git
VoyahTune-Installer-*.exe
